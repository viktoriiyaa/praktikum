        }

        if (abs(term) < 1e-10 || abs(term) > 1e10) {
            cout << "Расходится." << endl; // Заменено
            return numeric_limits<double>::quiet_NaN();
        }

        double old_product = product;
        product *= term;

        n++;
        terms_calculated++;


    }

    while (terms_calculated < max_terms) {
        switch (problem_number) {
            case 1:
                term = (1.0 - (1.0 / pow(n, 2)));
                break;
            case 2:
                term = (pow(n, 3) - 1.0) / (pow(n, 3) + 1.0);
                break;
            case 3:
                term = (pow(n, 2) + n - 6.0) / (pow(n, 2) + n - 2.0);
                break;
            case 4:

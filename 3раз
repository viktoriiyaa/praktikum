using namespace std;

double calculate_product_series(int problem_number, int max_terms = 1000) {
    double product = 1.0;
    double term;
    double tolerance = 1e-6;
    int n = 0;
    int terms_calculated = 0;

    switch (problem_number) {
        case 1: n = 2; break;
        case 2: n = 2; break;
        case 3: n = 3; break;
        case 4: n = 0; break;
        default:
            cout << "Некорректный номер задачи." << endl; // Заменено

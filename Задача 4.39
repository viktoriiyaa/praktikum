#include <iostream>
#include <iomanip>
#include <cmath>

using namespace std;

// Функция для вычисления суммы ряда с точностью tolerance
double sum_series(double x, double tolerance = 1e-6, int max_terms = 100000) {
   double sum = 0.0;
   double term;
   int n = 1;

   double ratio = x / 9.0;

   if (fabs(ratio) >= 1.0) {
       cout << "Ряд расходится при x = " << x << endl;
       return NAN;
   }

   while (n <= max_terms) {
       term = pow(ratio, n) / (n * n);
       sum += term;

       if (fabs(term) < tolerance) {
           break;
       }
       n++;
   }

   if (n == max_terms + 1) {
       cout << "Достигнуто максимальное количество членов ряда, возможно, сходимость медленная." << endl;
   }

   return sum;
}

int main() {
   cout << fixed << setprecision(10);

   double x;
   cout << "Введите значение x: ";
   cin >> x;

   cout << "Радиус сходимости: |x| < 9" << endl;

   double result = sum_series(x);

   if (!isnan(result)) {
       cout << "Сумма ряда при x = " << x << " равна: " << result << endl;
   }

   return 0;
}

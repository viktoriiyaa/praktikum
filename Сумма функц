#include <iostream>
#include <cmath>

// Create function sin(x)
double func(double x, int n) {
    double sum_f = 0.0;
    double q = x;

    for (int i = 1; i < n; ++i) {
        sum_f += q;
        double p = (double)((2.0 * i) * (2.0 * i + 1));
        q *= pow(-1.0, (2 * x + 1)) / p;
    }
    return sum_f;
}

int main() {
    // driver nodes
    // Enter value in degree in x
    double x;
    std::cout << "Enter value in degree in x = ";
    std::cin >> x;

    // Enter number of terms
    int n;
    std::cout << "Enter number of terms n = ";
    std::cin >> n;

    // call function
    double s = func(x, n);

    std::cout << "sum = " << s << std::endl;

    return 0;
}

#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

// Функция для вычисления суммы первого ряда
double sum_series_1(double tolerance = 1e-6, int max_terms = 100000) {
    double sum = 0.0;
    double term;
    int k = 1;

    while (k <= max_terms) {
        term = 3.0 / (pow(2, k) - pow(-1, k - 1) * pow(2, k - 1));
        sum += term;

        if (fabs(term) < tolerance) {
            break;
        }
        k++;
    }

    return sum;
}

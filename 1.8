#include <iostream>
#include <cmath>
#include <iomanip>

double f(double x) {
    return log(x) / pow(x, 2); // Изменяем функцию на ln(x) / x^2
}

double rectangleMethod(double a, double b, int n) {
    double h = (b - a) / n;
    double sum = 0.0;

    for (int i = 0; i < n; ++i) {
        double x = a + i * h;
        sum += f(x) * h;
    }

    return sum;
}

int main() {
    double a = 1.0; // Устанавливаем нижнюю границу интегрирования
    double b = 20.0; // Увеличиваем верхнюю границу до 20
    double precision = 1e-10;
    int n = 1;
    double integral = 0.0;
    double previousIntegral = 0.0;

    do {
        previousIntegral = integral;
        integral = rectangleMethod(a, b, n);
        n *= 2;

        std::cout << "Integral: " << integral << ", Previous Integral: " << previousIntegral << ", n: " << n << std::endl;

    } while (fabs(integral - previousIntegral) > precision);

    std::cout << std::fixed << std::setprecision(10);
    std::cout << "Приближенное значение интеграла от " << a << " до +бесконечности: " << integral << std::endl;

    return 0;
}

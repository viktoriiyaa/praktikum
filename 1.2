#include <iostream>
#include <cmath>
#include <iomanip>

double f(double x) {
    return (1 / (x * x)) * sin(1 / x); // f(x) = (1/x^2) * sin(1/x)
}

double rectangleMethod(double epsilon, double b, int n) {
    double h = (b - epsilon) / n; // Ширина прямоугольников
    double sum = 0.0;

    for (int i = 0; i < n; ++i) {
        double x = epsilon + i * h; // Левый конец интервала
        sum += f(x) * h; // Площадь прямоугольника
    }

    return sum;
}

int main() {
    double epsilon = 1e-10; // Маленькое значение для нижнего предела
    double b = 1.0; // Верхний предел
    double previousResult = 0.0;
    double result = 0.0;
    int n = 1; // Начальное количество прямоугольников

    // Перебираем значения a
    std::cout << "Интеграл от 0 до 1 для функции (1/x^2) * sin(1/x):" << std::endl;

    while (true) {
        result = rectangleMethod(epsilon, b, n);
        
        // Проверка на сходимость
        if (fabs(result - previousResult) < 1e-6) {
            break; // Достигнута заданная точность
        }

        previousResult = result;
        n *= 2; // Увеличиваем количество прямоугольников
    }

    std::cout << std::fixed << std::setprecision(6);
    std::cout << "Значение интеграла от (1/x^2) * sin(1/x) от " << epsilon << " до " << b << " = " << result << std::endl;

    return 0;
}

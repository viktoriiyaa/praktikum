#include <iostream>
#include <cmath>
#include <iomanip>

double term(double x, int n) {
    return cos(n * x) / exp(n);
}

int main() {
    double x;
    std::cout << "Enter the value of x: ";
    std::cin >> x;

    double sum = 0.0;
    double tolerance = 1e-6; // 10^-6
    int n = 1;
    double current_term = term(x, n);

    while (std::abs(current_term) > tolerance) {
        sum += current_term;
        n++;
        current_term = term(x, n);
    }

    std::cout << "The sum of the series is: " << std::fixed << std::setprecision(8) << sum << std::endl;

    return 0;
}

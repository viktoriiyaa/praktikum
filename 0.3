// Функция для вычисления суммы третьего ряда
double sum_series_3(double tolerance = 1e-6, int max_terms = 100000) {
    double sum = 0.0;
    double term;
    int n = 1;

    while (n <= max_terms) {
        term = pow(-1, n) / (pow(3, n) * pow(2, n));
        sum += term;

        if (fabs(term) < tolerance) {
            break;
        }
        n++;
    }

    return sum;
}

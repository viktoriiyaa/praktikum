#include <iostream>
#include <iomanip>
#include <cmath>

using namespace std;

// Функция для вычисления произведения до заданной точности, используя метод суммирования членов ряда
double calculate_product_series(int problem_number, int max_terms = 1000) {
    double product = 1.0;
    double term;
    double tolerance = 1e-6; // 10^-6
    int n = 0; // Начальное значение n для каждой задачи
    int terms_calculated = 0;

    // Установим начальное значение n в зависимости от номера задачи
    switch (problem_number) {
        case 1: n = 2; break;
        case 2: n = 2; break;
        case 3: n = 3; break;
        case 4: n = 0; break;
        default:
            cout << "Некорректный номер задачи." << endl;
            return NAN; // Возвращаем NAN для обозначения ошибки
    }

    // Вычисление произведения до достижения заданной точности или до достижения лимита итераций
    while (terms_calculated < max_terms) {
        switch (problem_number) {
            case 1:
                term = (1.0 - (1.0 / (n * n)));
                break;
            case 2:
                term = ((pow(n, 3) - 1.0) / (pow(n, 3) + 1.0));
                break;
            case 3:
                term = ((pow(n, 2) + n - 6.0) / (pow(n, 2) + n - 2.0));
                break;
            case 4:
                term = (1.0 + pow(1.0 / 3.0, n));
                break;
            default:
                return NAN; // Никогда не достигнет, если начальная проверка прошла
        }

        // Проверка на расходимость (если член слишком близок к 0 или бесконечности)
        if (abs(term) < 1e-10 || abs(term) > 1e10) {
            cout << "Расходится." << endl;
            return NAN;
        }

        // Умножаем текущее произведение на очередной член
        double old_product = product;
        product *= term;

        // Увеличиваем n
        n++;
        terms_calculated++;

        // Проверяем сходимость (изменение произведения меньше заданной точности)
        if (abs(product - old_product) < tolerance) {
            cout << "Сходится." << endl;
            return product;
        }
    }

    cout << "Превышено максимальное количество членов ряда.  Возможно, расходится или сходится очень медленно." << endl;
    return NAN;
}

int main() {
    // Вычисляем и выводим результаты для каждой задачи
    for (int i = 1; i <= 4; ++i) {
        cout << "Задача " << i << ": ";
        double result = calculate_product_series(i);
        if (!isnan(result)) {
            cout << fixed << setprecision(10) << result << endl;
        }
    }

    return 0;
}
